{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/WhiteBite/harness-kit/main/registry/harnesses.schema.json",
  "title": "harness-kit registry",
  "description": "Language-neutral contract describing AI coding harness wiring facts. Unknown keys are tolerated at every level (forward compatibility): consumers must ignore what they do not understand.",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "harnesses"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "registryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "conventions": { "type": "object" },
    "harnesses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/harness" }
    }
  },
  "definitions": {
    "harness": {
      "type": "object",
      "required": ["name", "status"],
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "stable" } }, "required": ["status"] },
          "then": { "required": ["verified"] }
        }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["stable", "preview", "experimental"] },
        "envOverrides": { "type": "object" },
        "verified": {
          "type": "object",
          "required": ["against", "at"],
          "properties": {
            "against": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "headless": {
          "type": "object",
          "required": ["run", "promptDelivery", "promptFlag", "provider", "integration", "status"],
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "stable" } }, "required": ["status"] },
              "then": { "required": ["verified"] }
            }
          ],
          "properties": {
            "run": { "type": "string", "minLength": 1 },
            "promptDelivery": { "enum": ["arg", "stdin", "file"] },
            "promptFlag": { "type": ["string", "null"] },
            "provider": {
              "type": "object",
              "required": ["override", "wire", "auth", "model"],
              "properties": {
                "override": {
                  "type": "object",
                  "required": ["kind", "key"],
                  "properties": {
                    "kind": { "enum": ["env", "config"] },
                    "key": { "type": "string", "minLength": 1 }
                  }
                },
                "wire": { "enum": ["anthropic-messages", "openai-chat", "openai-responses", "google-genai"] },
                "auth": {
                  "type": "object",
                  "required": ["kind", "key"],
                  "properties": {
                    "kind": { "enum": ["env", "config"] },
                    "key": { "type": "string", "minLength": 1 }
                  }
                },
                "model": { "type": "string", "minLength": 1 }
              }
            },
            "integration": { "enum": ["json-hooks", "json-hooks-unsupported-shape", "config-file-hooks", "code-plugin", "composition", "none"] },
            "status": { "enum": ["stable", "preview", "experimental"] },
            "verified": {
              "type": "object",
              "required": ["against", "at"],
              "properties": {
                "against": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          }
        },
        "hooks": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["config", "write"],
              "allOf": [
                {
                  "if": { "properties": { "write": { "const": "merge" } }, "required": ["write"] },
                  "then": { "required": ["shape"] }
                }
              ],
              "properties": {
                "config": {
                  "type": "object",
                  "required": ["project"],
                  "properties": {
                    "project": { "type": "string" },
                    "user": { "type": "string" }
                  }
                },
                "resolveVia": { "type": "string" },
                "write": { "enum": ["merge", "overwrite", "marker-block", "print-only"] },
                "shape": { "enum": ["nested-hooks", "root-events", "versioned-flat", "versioned-typed", "flat-matcher", "hooks-array"] },
                "envelope": { "type": "object" },
                "events": { "type": "array", "items": { "type": "string" } },
                "triggers": { "type": "array", "items": { "type": "string" } },
                "entryFields": { "type": "object" },
                "markers": { "type": "object" },
                "pluginRootVar": { "type": "string" },
                "toolNames": { "type": "array", "items": { "type": "string" } },
                "envOverrides": { "type": "object" },
                "timeoutUnit": { "type": "string" }
              }
            }
          ]
        },
        "plugin": { "type": "object" },
        "mcp": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["config", "format", "container"],
              "allOf": [
                {
                  "if": { "properties": { "write": { "const": "merge" } }, "required": ["write"] },
                  "then": { "properties": { "format": { "const": "json" } } }
                },
                {
                  "if": { "properties": { "write": { "const": "merge-text" } }, "required": ["write"] },
                  "then": { "properties": { "format": { "enum": ["jsonc", "toml"] } } }
                }
              ],
              "properties": {
                "status": { "enum": ["stable", "preview", "experimental"] },
                "verified": {
                  "type": "object",
                  "required": ["against", "at"],
                  "properties": {
                    "against": { "type": "string", "minLength": 1 },
                    "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                  }
                },
                "config": { "type": "object" },
                "format": { "enum": ["json", "jsonc", "toml"] },
                "container": { "type": "string" },
                "urlField": { "type": "string" },
                "typeField": { "type": "string" },
                "typeValue": { "type": "string" },
                "tokenEnvSyntax": { "type": ["string", "null"] },
                "authField": { "type": "string" },
                "write": { "enum": ["merge", "merge-text", "print-only"] },
                "source": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "skills": {
          "type": "object",
          "properties": {
            "global": { "type": "array", "items": { "type": "string" } },
            "project": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "format"],
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["plain", "mdc", "marker-block"] },
              "ownership": { "type": "string" },
              "frontmatter": { "type": "array", "items": { "type": "string" } },
              "markers": { "type": "object" },
              "note": { "type": "string" }
            }
          }
        },
        "manifests": { "type": "object" },
        "notes": { "type": "string" }
      }
    }
  }
}
