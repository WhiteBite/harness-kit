{
  "theme": "opencode",
  "windowTitle": "harness configs",
  "takeaway": "One owner-scoped merge call replaces three hand-edited harness configs",

  "before": {
    "surface": "files",
    "caption": "hand-edited, drifting",
    "windowTitle": "harness configs",
    "sessionTitle": "three configs, three dialects",
    "blocks": [
      { "type": "file", "path": ".claude/settings.json", "lines": [
        { "type": "del", "text": "\"PreToolUse\": [{ \"command\": \"node scan.mjs\" }]" }
      ] },
      { "type": "file", "path": ".codex/hooks.json", "lines": [
        { "type": "del", "text": "\"PreToolUse\": [{ \"command\": \"./scan.mjs --pre\" }]" }
      ] },
      { "type": "file", "path": ".opencode/plugin/slop-gate.ts", "lines": [
        { "type": "del", "text": "export default { id: \"slopgate\" }" }
      ] },
      { "type": "status", "text": "3 harnesses, 3 dialects, 3 strings" }
    ]
  },

  "after": {
    "surface": "files",
    "caption": "one merge, consistent",
    "windowTitle": "harness-kit registry",
    "sessionTitle": "one registry, one call",
    "blocks": [
      { "type": "file", "path": "slop-gate.js", "lines": [
        { "type": "add", "left": "export default {", "right": "" },
        { "type": "add", "left": "id: \"slop-gate\",", "right": "" },
        { "type": "add", "left": "PreToolUse: [{ command: \"node scan.mjs\" }],", "right": "" },
        { "type": "add", "left": "}", "right": "" }
      ] },
      { "type": "tool", "text": "mergeHooks(repoRoot, \"slop-gate\")" },
      { "type": "done", "text": "3 harnesses, 1 template, 0 drift" }
    ]
  }
}
