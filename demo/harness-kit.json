{
  "theme": "shell",
  "windowTitle": "harness configs",
  "takeaway": "One owner-scoped merge call replaces three hand-edited harness configs",

  "before": {
    "surface": "files",
    "caption": "hand-edited, drifting",
    "windowTitle": "harness configs",
    "sessionTitle": "three configs, three paths",
    "blocks": [
      { "type": "file", "path": ".claude/settings.json", "lines": [
        { "type": "del", "text": "\"PreToolUse\": [{" },
        { "type": "del", "text": "\"matcher\": \"Write|Edit\"," },
        { "type": "del", "text": "\"hooks\": [{ \"type\": \"command\"," }
      ] },
      { "type": "file", "path": ".codex/hooks.json", "lines": [
        { "type": "del", "text": "\"PreToolUse\": [{" },
        { "type": "del", "text": "\"matcher\": \"Write|Edit|MultiEdit\"," },
        { "type": "del", "text": "\"hooks\": [{ \"type\": \"command\"," }
      ] },
      { "type": "file", "path": ".opencode/plugin/slop-gate.ts", "lines": [
        { "type": "del", "text": "export { default } from \"/abs/slop-gate.js\";" }
      ] },
      { "type": "status", "text": "3 harnesses, 3 config files, 3 hand-edits" }
    ]
  },

  "after": {
    "surface": "files",
    "caption": "one merge, consistent",
    "windowTitle": "harness-kit registry",
    "sessionTitle": "one registry, one call",
    "blocks": [
      { "type": "file", "path": "registry/harnesses.json", "lines": [
        { "type": "add", "text": "\"write\": \"merge\"," },
        { "type": "add", "text": "\"shape\": \"nested-hooks\"," }
      ] },
      { "type": "tool", "kind": "call", "text": "mergeHooks(existing, template, { shape, isMine })" },
      { "type": "done", "text": "3 harnesses, 1 registry, 0 drift" }
    ]
  }
}
