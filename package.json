{
  "name": "@whitebite/harness-kit",
  "version": "2.1.0",
  "description": "Canonical registry and zero-dependency primitives for wiring AI coding harnesses (Claude Code, Codex, OpenCode 1.x/2.x, Gemini, Qwen, Cursor, Windsurf, Kiro, Devin, Copilot, Crush, Cline, Aider): config paths, hook dialects, owner-scoped merges, skill symlinks, marker blocks.",
  "type": "module",
  "types": "./types/index.d.mts",
  "bin": { "harness-kit": "bin/harness-kit.mjs" },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./registry": "./registry/harnesses.json",
    "./schema": "./registry/harnesses.schema.json"
  },
  "files": [
    "src",
    "registry",
    "types",
    "bin",
    "docs",
    "manifest.json",
    "assets",
    "README.md",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md",
    "MIGRATIONS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test && node scripts/selftest.mjs",
    "self-test": "node scripts/selftest.mjs",
    "manifest": "node scripts/manifest.mjs",
    "manifest:check": "node scripts/manifest.mjs --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:tag": "node scripts/version.mjs tag",
    "release": "node scripts/version.mjs release",
    "release:check": "node scripts/release-check.mjs"
  },
  "keywords": [
    "ai-harness",
    "claude-code",
    "codex-cli",
    "opencode",
    "gemini-cli",
    "cursor",
    "kiro",
    "devin",
    "copilot",
    "hooks",
    "agent-skills",
    "installer",
    "registry",
    "zero-dependencies",
    "open-source"
  ],
  "author": "WhiteBite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBite/harness-kit.git"
  },
  "bugs": {
    "url": "https://github.com/WhiteBite/harness-kit/issues"
  },
  "homepage": "https://github.com/WhiteBite/harness-kit"
}
